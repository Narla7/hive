# Only required when running with an LLM decisioner (--model <id>).
# The default, offline/rules, needs no key and no network at all.

# Any OpenAI-compatible endpoint works.
HIVE_BASE_URL=https://openrouter.ai/api/v1
HIVE_API_KEY=

# OpenCode Zen (pay-as-you-go, the only one of the two that suits unattended runs)
#   HIVE_BASE_URL=https://opencode.ai/zen/v1
#
#   Two hard limits found by probing, both of which cost nothing to discover
#   now and thousands of calls to discover later:
#     - Zen's free models (big-pickle, everything "*-free") return
#       FreeTierError 403 unless the call originates from inside OpenCode.
#       An external script cannot use them.
#     - Zen's paid models return 402 "Insufficient account funds" until the
#       account has a balance.
#   Cheapest usable models: deepseek-v4-flash ($0.14/$0.28 per 1M),
#   glm-5.3-flash ($0.15/$0.50). A 1,700-call trial costs roughly $0.30.
#   Note Zen auto-reloads $20 when the balance drops below $5; disable that
#   if you want a hard ceiling.
#
# OpenCode Go ($10/mo, but rate-capped per rolling window - dev/CI only)
#   HIVE_BASE_URL=https://opencode.ai/zen/go/v1
#
# OpenAI / Codex
#   HIVE_BASE_URL=https://api.openai.com/v1
#
# Claude, with --provider anthropic
#   HIVE_BASE_URL=https://api.anthropic.com
